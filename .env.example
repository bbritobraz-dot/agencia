# =============================================================================
# Plataforma RUNA — Variáveis de Ambiente
# =============================================================================

# URL e Chave Pública (Anon Key) do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Service Role Key do Supabase (EXCLUSIVA DO SERVIDOR — NUNCA prefixe com NEXT_PUBLIC_)
# Necessária para que os endpoints públicos (/api/diagnostics/submit e /api/leads/contact)
# gravem novos leads e diagnósticos com RLS estrito sem permitir leitura pública.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Contato oficial do WhatsApp da RUNA (formato DDI+DDD+Número, apenas dígitos)
NEXT_PUBLIC_RUNA_WHATSAPP=554584317910

# URL canônica do site para metadados SEO e Sitemap
NEXT_PUBLIC_SITE_URL=https://runamkt.com.br

# IDs opcionais de Analytics (carregados mediante consentimento LGPD)
NEXT_PUBLIC_GA4_ID=G-N518Q5F867
NEXT_PUBLIC_META_PIXEL_ID=1317871627202660
